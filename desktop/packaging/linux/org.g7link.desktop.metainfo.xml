<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.g7link.desktop</id>
  <name>G7 Link</name>
  <summary>Connect your Android phone and Linux PC over LAN</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.astraque">
    <name>Astraque Softwares Ltd</name>
  </developer>
  <description>
    <p>
      G7 Link links your Android phone and Linux desktop over your local network with end-to-end encryption.
    </p>
    <ul>
      <li>Sync clipboard text and images bidirectionally</li>
      <li>Mirror phone notifications and reply inline from your desktop</li>
      <li>Send and receive files, folders, and browsable phone storage via FUSE</li>
      <li>Stream phone screen, camera, and audio with low latency</li>
      <li>Read and send SMS/MMS messages and manage phone calls</li>
    </ul>
  </description>
  <launchable type="desktop-id">g7link.desktop</launchable>
  <url type="homepage">https://github.com/Astraque-Softwares-Ltd/g7link</url>
  <url type="bugtracker">https://github.com/Astraque-Softwares-Ltd/g7link/issues</url>
  <provides>
    <binary>g7link-desktop</binary>
    <mediatype>x-scheme-handler/g7link</mediatype>
    <mediatype>x-scheme-handler/tel</mediatype>
    <mediatype>x-scheme-handler/sms</mediatype>
    <mediatype>x-scheme-handler/smsto</mediatype>
    <mediatype>x-scheme-handler/mms</mediatype>
    <mediatype>x-scheme-handler/mmsto</mediatype>
  </provides>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.1.11" date="2026-11-12" />
    <release version="0.1.10" date="2026-11-12" />
    <release version="0.1.9" date="2026-11-11" />
    <release version="0.1.6" date="2026-11-11" />
  </releases>
</component>
