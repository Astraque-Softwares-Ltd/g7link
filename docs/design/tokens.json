{
  "$schema": "g7link-design-tokens/v1",
  "$description": "Single source of truth for G7 Link design tokens: the G7 theme's colors, type, shape and layout, with spacing and motion. The desktop QML tokens are generated from this file; the color-only palettes from G7 Linux's theme files come from scripts/gen-palettes.py.",
  "themes": {
    "quiet": {
      "description": "G7's Quiet Tool language (docs/design-language.md in g7linux). Charcoal and paper grounds, neutral selection, lavender only for focus, the primary button and the mark, Geist Mono everywhere, bare glyphs in their own tints, rows instead of cards. Colors are fixed.",
      "dynamicColor": false,
      "fonts": {
        "display": "Geist Mono",
        "label": "Geist Mono",
        "mono": "Geist Mono",
        "ui": "Geist Mono"
      },
      "label": {
        "case": "none",
        "size": 12,
        "tracking": 0,
        "weight": 500
      },
      "shape": {
        "xs": 5,
        "sm": 6,
        "md": 8,
        "lg": 8,
        "xl": 12,
        "full": 8
      },
      "variants": {
        "dark": {
          "accent": "#B292D0",
          "onAccent": "#18181B",
          "primary": "#F2F2F3",
          "onPrimary": "#18181B",
          "primaryContainer": "#2B2B30",
          "onPrimaryContainer": "#F2F2F3",
          "secondaryContainer": "#2B2B30",
          "onSecondaryContainer": "#F2F2F3",
          "surface": "#18181B",
          "surfaceContainerLow": "#18181B",
          "surfaceContainer": "#222226",
          "surfaceContainerHigh": "#2B2B30",
          "surfaceContainerHighest": "#303035",
          "onSurface": "#F2F2F3",
          "onSurfaceVariant": "#A1A1A8",
          "outline": "#6F6F78",
          "outlineVariant": "#303035",
          "success": "#F2F2F3",
          "warning": "#E2C47A",
          "error": "#F0A39C",
          "onError": "#3B0B07"
        },
        "light": {
          "accent": "#7D5CA9",
          "onAccent": "#FAFAFB",
          "primary": "#1C1C1F",
          "onPrimary": "#FAFAFB",
          "primaryContainer": "#E9E9ED",
          "onPrimaryContainer": "#1C1C1F",
          "secondaryContainer": "#E9E9ED",
          "onSecondaryContainer": "#1C1C1F",
          "surface": "#FAFAFB",
          "surfaceContainerLow": "#FAFAFB",
          "surfaceContainer": "#F1F1F3",
          "surfaceContainerHigh": "#E9E9ED",
          "surfaceContainerHighest": "#E4E4E9",
          "onSurface": "#1C1C1F",
          "onSurfaceVariant": "#5F5F67",
          "outline": "#7A7A83",
          "outlineVariant": "#DCDCE1",
          "success": "#1C1C1F",
          "warning": "#6F5200",
          "error": "#A4230F",
          "onError": "#FFFFFF"
        }
      },
      "tints": {
        "$note": "Glyph tints: each section and action draws its glyph in one of these, bare. Lavender doubles as the accent.",
        "dark": {
          "lavender": "#B292D0",
          "blue": "#7CB7EE",
          "teal": "#5DCAA5",
          "coral": "#F0997B",
          "pink": "#ED93B1",
          "amber": "#EF9F27",
          "green": "#97C459",
          "red": "#E5736F"
        },
        "light": {
          "lavender": "#7D5CA9",
          "blue": "#2F6DAE",
          "teal": "#1E7F64",
          "coral": "#B4532F",
          "pink": "#AE4470",
          "amber": "#8F5B00",
          "green": "#4B7516",
          "red": "#B3322D"
        }
      },
      "typography": {
        "$note": "The one scale: 13 px text, 12 px small text and section labels, line height 1.4.",
        "displayLarge": {
          "size": 22,
          "lineHeight": 1.3,
          "weight": 500,
          "tracking": 0
        },
        "displaySmall": {
          "size": 18,
          "lineHeight": 1.3,
          "weight": 500,
          "tracking": 0
        },
        "headline": {
          "size": 18,
          "lineHeight": 1.3,
          "weight": 500,
          "tracking": 0
        },
        "title": {
          "size": 13,
          "lineHeight": 1.4,
          "weight": 500,
          "tracking": 0
        },
        "body": {
          "size": 13,
          "lineHeight": 1.4,
          "weight": 400,
          "tracking": 0
        },
        "bodySmall": {
          "size": 12,
          "lineHeight": 1.4,
          "weight": 400,
          "tracking": 0
        },
        "label": {
          "size": 12,
          "lineHeight": 1.4,
          "weight": 500,
          "tracking": 0
        },
        "caption": {
          "size": 11,
          "lineHeight": 1.4,
          "weight": 400,
          "tracking": 0
        },
        "code": {
          "size": 13,
          "lineHeight": 1.4,
          "weight": 500,
          "tracking": 0
        }
      },
      "layout": {
        "$note": "The window: header, sidebar, footer; rows 36 px with 10 px padding and an 8 px radius.",
        "headerHeight": 52,
        "sidebarWidth": 200,
        "footerHeight": 40,
        "rowHeight": 36,
        "rowPadding": 10,
        "rowRadius": 8,
        "columnWidth": 300
      }
    }
  },
  "spacing": {
    "unit": 4,
    "scale": [
      0,
      2,
      4,
      6,
      8,
      10,
      12,
      16,
      20,
      24,
      32,
      40,
      48,
      64
    ]
  },
  "layout": {
    "desktop": {
      "railWidth": 80,
      "topBarHeight": 52,
      "contentPadding": 22,
      "gutter": 16,
      "minWindow": [
        880,
        600
      ]
    },
    "phone": {
      "screenPadding": 16,
      "gutter": 10,
      "tabBarHeight": 64
    }
  },
  "motion": {
    "description": "Shared with the G7 Linux launcher; see docs/design/motion.md. Things leave faster than they arrive. Under reduced motion nothing moves or scales; page changes keep a quick crossfade.",
    "duration": {
      "quick": { "enter": 120, "exit": 90, "use": "hover, press, color and selection changes, tooltips" },
      "small": { "enter": 200, "exit": 140, "use": "chips, banners, toasts, menus, popovers, list rows" },
      "large": { "enter": 260, "exit": 180, "use": "pages, tabs, sheets, expand and collapse" }
    },
    "easing": {
      "enter": [0.05, 0.7, 0.1, 1],
      "exit": [0.3, 0, 0.8, 0.15],
      "move": [0.2, 0, 0, 1]
    },
    "distance": {
      "rise": 8,
      "pageSlide": 0.1,
      "popScale": 0.96
    },
    "spring": {
      "gentle": {
        "stiffness": 220,
        "damping": 26,
        "use": "page and panel transitions"
      },
      "standard": {
        "stiffness": 380,
        "damping": 30,
        "use": "cards, sheets, expanding a notification into a conversation"
      },
      "snappy": {
        "stiffness": 620,
        "damping": 34,
        "use": "toggles, chips, buttons, hover lift"
      }
    },
    "fade": {
      "fast": 120,
      "normal": 200
    },
    "hoverLift": 2,
    "pressScale": 0.97
  },
  "icons": {
    "set": "Material Symbols Rounded (Apache-2.0)",
    "size": 20,
    "stroke": "outlined, 400 weight; filled when selected"
  }
}
