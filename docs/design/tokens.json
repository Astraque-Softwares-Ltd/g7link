{
  "$schema": "g7link-design-tokens/v1",
  "$description": "Single source of truth for G7 Link design tokens: the G7 theme's colors, type, shape and layout, with spacing and motion. The desktop QML tokens are generated from this file; the color-only palettes from G7 Linux's theme files come from scripts/gen-palettes.py.",
  "themes": {
    "quiet": {
      "description": "G7's Quiet Tool language (docs/design-language.md in g7linux). Charcoal and paper grounds, neutral selection, lavender only for focus, the primary button and the mark, Figtree for text and Geist Mono for codes and keys, bare glyphs in their own tints, rows instead of cards. Colors are fixed.",
      "dynamicColor": false,
      "fonts": {
        "display": "Figtree",
        "label": "Figtree",
        "mono": "Geist Mono",
        "ui": "Figtree"
      },
      "label": {
        "case": "none",
        "size": 12,
        "tracking": 0,
        "weight": 500
      },
      "shape": {
        "xs": 5,
        "sm": 6,
        "md": 8,
        "lg": 8,
        "xl": 12,
        "full": 8
      },
      "variants": {
        "dark": {
          "accent": "#B292D0",
          "onAccent": "#18181B",
          "primary": "#F2F2F3",
          "onPrimary": "#18181B",
          "primaryContainer": "#2B2B30",
          "onPrimaryContainer": "#F2F2F3",
          "secondaryContainer": "#2B2B30",
          "onSecondaryContainer": "#F2F2F3",
          "surface": "#18181B",
          "surfaceContainerLow": "#18181B",
          "surfaceContainer": "#222226",
          "surfaceContainerHigh": "#2B2B30",
          "surfaceContainerHighest": "#303035",
          "onSurface": "#F2F2F3",
          "onSurfaceVariant": "#A1A1A8",
          "outline": "#6F6F78",
          "outlineVariant": "#303035",
          "success": "#F2F2F3",
          "warning": "#E2C47A",
          "error": "#F0A39C",
          "onError": "#3B0B07"
        },
        "light": {
          "accent": "#7D5CA9",
          "onAccent": "#FAFAFB",
          "primary": "#1C1C1F",
          "onPrimary": "#FAFAFB",
          "primaryContainer": "#E9E9ED",
          "onPrimaryContainer": "#1C1C1F",
          "secondaryContainer": "#E9E9ED",
          "onSecondaryContainer": "#1C1C1F",
          "surface": "#FAFAFB",
          "surfaceContainerLow": "#FAFAFB",
          "surfaceContainer": "#F1F1F3",
          "surfaceContainerHigh": "#E9E9ED",
          "surfaceContainerHighest": "#E4E4E9",
          "onSurface": "#1C1C1F",
          "onSurfaceVariant": "#5F5F67",
          "outline": "#7A7A83",
          "outlineVariant": "#DCDCE1",
          "success": "#1C1C1F",
          "warning": "#6F5200",
          "error": "#A4230F",
          "onError": "#FFFFFF"
        }
      },
      "tints": {
        "$note": "Glyph tints: each section and action draws its glyph in one of these, bare. Lavender doubles as the accent.",
        "dark": {
          "lavender": "#B292D0",
          "blue": "#7CB7EE",
          "teal": "#5DCAA5",
          "coral": "#F0997B",
          "pink": "#ED93B1",
          "amber": "#EF9F27",
          "green": "#97C459",
          "red": "#E5736F"
        },
        "light": {
          "lavender": "#7D5CA9",
          "blue": "#2F6DAE",
          "teal": "#1E7F64",
          "coral": "#B4532F",
          "pink": "#AE4470",
          "amber": "#8F5B00",
          "green": "#4B7516",
          "red": "#B3322D"
        }
      },
      "tintsText": {
        "$note": "Tints as text in light: each light tint darkened until 4.6:1 on surfaceContainerHigh. Amber and red already pass. Dark tints are text as they are.",
        "light": {
          "lavender": "#7858A2",
          "blue": "#2E6AA9",
          "teal": "#1C755C",
          "coral": "#A74D2C",
          "pink": "#AB436E",
          "amber": "#8F5B00",
          "green": "#4A7316",
          "red": "#B3322D"
        }
      },
      "typography": {
        "$note": "The one scale: 14 px text, 13 px small text and section labels, 12 px captions, line height 1.4; an agent chat's prose at 15 px, line height 1.55.",
        "displayLarge": {
          "size": 22,
          "lineHeight": 1.3,
          "weight": 500,
          "tracking": 0
        },
        "displaySmall": {
          "size": 18,
          "lineHeight": 1.3,
          "weight": 500,
          "tracking": 0
        },
        "headline": {
          "size": 18,
          "lineHeight": 1.3,
          "weight": 500,
          "tracking": 0
        },
        "title": {
          "size": 14,
          "lineHeight": 1.4,
          "weight": 500,
          "tracking": 0
        },
        "body": {
          "size": 14,
          "lineHeight": 1.4,
          "weight": 400,
          "tracking": 0
        },
        "bodySmall": {
          "size": 13,
          "lineHeight": 1.4,
          "weight": 400,
          "tracking": 0
        },
        "label": {
          "size": 13,
          "lineHeight": 1.4,
          "weight": 500,
          "tracking": 0
        },
        "caption": {
          "size": 12,
          "lineHeight": 1.4,
          "weight": 400,
          "tracking": 0
        },
        "code": {
          "size": 13,
          "lineHeight": 1.4,
          "weight": 500,
          "tracking": 0
        },
        "prose": {
          "size": 15,
          "lineHeight": 1.55,
          "weight": 400,
          "tracking": 0
        }
      },
      "layout": {
        "$note": "The window: header, sidebar, footer; rows 36 px with 10 px padding and an 8 px radius.",
        "headerHeight": 52,
        "sidebarWidth": 200,
        "footerHeight": 40,
        "rowHeight": 36,
        "rowPadding": 10,
        "rowRadius": 8,
        "columnWidth": 300
      },
      "agents": {
        "$note": "The agent timeline's colours (plans/agent-colour.md §2), generated for all three clients by `cargo xtask tokens`. A value is a hex, or a wash: `color` drawn at `alpha` over the ground. `syntax` has one colour per render-crate token class; `tool` per tool class (the glyph); `styles` the font style per class. `glyphOnly` roles are drawn as glyphs or rules, never as text. `mustDiffer` pairs must stay 0.06 or more apart in OKLab lightness.",
        "styles": {
          "comment": "italic",
          "keyword": "semibold",
          "tag": "semibold"
        },
        "glyphOnly": [
          "status.paused",
          "prose.headingRule"
        ],
        "dark": {
          "ground": {
            "surface": "#18181B",
            "code": "#222226",
            "chip": "#2B2B30"
          },
          "steps": {
            "dim": "#BDBDC4",
            "lavenderInk": "#D6C7E7",
            "addInk": "#B4D683",
            "delInk": "#F0A39C"
          },
          "syntax": {
            "plain": "#F2F2F3",
            "variable": "#D6C7E7",
            "operator": "#BDBDC4",
            "punctuation": "#A1A1A8",
            "comment": "#A1A1A8",
            "keyword": "#ED93B1",
            "tag": "#ED93B1",
            "string": "#5DCAA5",
            "number": "#F0997B",
            "constant": "#F0997B",
            "function": "#7CB7EE",
            "type": "#EF9F27",
            "attribute": "#EF9F27",
            "inserted": "#97C459",
            "deleted": "#E5736F",
            "dir": "#A1A1A8",
            "file": "#F2F2F3",
            "pos": "#A1A1A8",
            "error": "#F0A39C",
            "warn": "#EF9F27",
            "ok": "#97C459"
          },
          "diff": {
            "addRow": {
              "color": "#97C459",
              "alpha": 0.24
            },
            "delRow": {
              "color": "#E5736F",
              "alpha": 0.13
            },
            "addWord": {
              "color": "#97C459",
              "alpha": 0.44
            },
            "delWord": {
              "color": "#E5736F",
              "alpha": 0.35
            },
            "text": "#F2F2F3",
            "addSign": "#B4D683",
            "delSign": "#F0A39C",
            "lineNo": "#BDBDC4",
            "hunk": "#A1A1A8",
            "hunkGround": "#2B2B30"
          },
          "status": {
            "working": "#7CB7EE",
            "needsYou": "#EF9F27",
            "onNeedsYou": "#18181B",
            "failed": "#E5736F",
            "failedText": "#F0A39C",
            "failedWash": {
              "color": "#E5736F",
              "alpha": 0.2
            },
            "done": "#97C459",
            "paused": "#6F6F78",
            "mayNeedYou": "#EF9F27"
          },
          "toolStatus": {
            "ok": "#97C459",
            "failed": "#E5736F",
            "running": "#7CB7EE",
            "asking": "#EF9F27",
            "denied": "#A1A1A8",
            "stopped": "#A1A1A8"
          },
          "tool": {
            "command": "#5DCAA5",
            "edit": "#F0997B",
            "read": "#7CB7EE",
            "search": "#ED93B1",
            "web": "#7CB7EE",
            "agent": "#B292D0",
            "mcp": "#A1A1A8",
            "tasks": "#A1A1A8",
            "plan": "#A1A1A8",
            "other": "#A1A1A8"
          },
          "prose": {
            "inlineCode": "#F0997B",
            "link": "#B292D0",
            "headingRule": "#B292D0",
            "listMarker": "#A1A1A8",
            "doneBox": "#97C459",
            "alertNote": "#7CB7EE",
            "alertTip": "#5DCAA5",
            "alertImportant": "#B292D0",
            "alertWarning": "#EF9F27",
            "alertCaution": "#E5736F",
            "tableHeader": "#A1A1A8",
            "thinking": "#A1A1A8"
          }
        },
        "light": {
          "ground": {
            "surface": "#FAFAFB",
            "code": "#F1F1F3",
            "chip": "#E9E9ED"
          },
          "steps": {
            "dim": "#45454C",
            "lavenderInk": "#4F3A73",
            "addInk": "#3B5C10",
            "delInk": "#8E1D0C"
          },
          "syntax": {
            "plain": "#1C1C1F",
            "variable": "#4F3A73",
            "operator": "#45454C",
            "punctuation": "#5F5F67",
            "comment": "#5F5F67",
            "keyword": "#AB436E",
            "tag": "#AB436E",
            "string": "#1C755C",
            "number": "#A74D2C",
            "constant": "#A74D2C",
            "function": "#2E6AA9",
            "type": "#8F5B00",
            "attribute": "#8F5B00",
            "inserted": "#4A7316",
            "deleted": "#8E1D0C",
            "dir": "#5F5F67",
            "file": "#1C1C1F",
            "pos": "#5F5F67",
            "error": "#8E1D0C",
            "warn": "#8F5B00",
            "ok": "#4A7316"
          },
          "diff": {
            "addRow": {
              "color": "#4B7516",
              "alpha": 0.1
            },
            "delRow": {
              "color": "#B3322D",
              "alpha": 0.26
            },
            "addWord": {
              "color": "#4B7516",
              "alpha": 0.32
            },
            "delWord": {
              "color": "#B3322D",
              "alpha": 0.46
            },
            "text": "#1C1C1F",
            "addSign": "#3B5C10",
            "delSign": "#8E1D0C",
            "lineNo": "#45454C",
            "hunk": "#5F5F67",
            "hunkGround": "#E9E9ED"
          },
          "status": {
            "working": "#2E6AA9",
            "needsYou": "#8F5B00",
            "onNeedsYou": "#FAFAFB",
            "failed": "#8E1D0C",
            "failedText": "#8E1D0C",
            "failedWash": {
              "color": "#B3322D",
              "alpha": 0.2
            },
            "done": "#4A7316",
            "paused": "#7A7A83",
            "mayNeedYou": "#8F5B00"
          },
          "toolStatus": {
            "ok": "#4A7316",
            "failed": "#8E1D0C",
            "running": "#2E6AA9",
            "asking": "#8F5B00",
            "denied": "#5F5F67",
            "stopped": "#5F5F67"
          },
          "tool": {
            "command": "#1E7F64",
            "edit": "#B4532F",
            "read": "#2F6DAE",
            "search": "#AE4470",
            "web": "#2F6DAE",
            "agent": "#7D5CA9",
            "mcp": "#5F5F67",
            "tasks": "#5F5F67",
            "plan": "#5F5F67",
            "other": "#5F5F67"
          },
          "prose": {
            "inlineCode": "#A74D2C",
            "link": "#7D5CA9",
            "headingRule": "#7D5CA9",
            "listMarker": "#5F5F67",
            "doneBox": "#4A7316",
            "alertNote": "#2E6AA9",
            "alertTip": "#1C755C",
            "alertImportant": "#7858A2",
            "alertWarning": "#8F5B00",
            "alertCaution": "#B3322D",
            "tableHeader": "#5F5F67",
            "thinking": "#5F5F67"
          }
        },
        "mustDiffer": [
          {
            "a": "diff.addRow",
            "b": "diff.delRow",
            "also": "+ and −"
          },
          {
            "a": "diff.addWord",
            "b": "diff.delWord",
            "also": "strike on removed"
          },
          {
            "a": "toolStatus.ok",
            "b": "toolStatus.failed",
            "also": "check and x"
          },
          {
            "a": "syntax.inserted",
            "b": "syntax.deleted",
            "also": "the line's own sign"
          },
          {
            "a": "status.needsYou",
            "b": "status.failed",
            "also": "fill, glyph"
          },
          {
            "a": "status.needsYou",
            "b": "ground.surface",
            "also": "spinner"
          },
          {
            "a": "prose.link",
            "b": "syntax.plain",
            "also": "underline"
          },
          {
            "a": "prose.inlineCode",
            "b": "syntax.plain",
            "also": "mono"
          },
          {
            "a": "syntax.comment",
            "b": "syntax.plain",
            "also": "italic"
          },
          {
            "a": "syntax.keyword",
            "b": "syntax.plain",
            "also": "weight"
          }
        ]
      }
    }
  },
  "spacing": {
    "unit": 4,
    "scale": [
      0,
      2,
      4,
      6,
      8,
      10,
      12,
      16,
      20,
      24,
      32,
      40,
      48,
      64
    ]
  },
  "layout": {
    "desktop": {
      "railWidth": 80,
      "topBarHeight": 52,
      "contentPadding": 22,
      "gutter": 16,
      "minWindow": [
        880,
        600
      ]
    },
    "phone": {
      "screenPadding": 16,
      "gutter": 10,
      "tabBarHeight": 64
    }
  },
  "motion": {
    "description": "Shared with the G7 Linux launcher; see docs/design/motion.md. Things leave faster than they arrive. Under reduced motion nothing moves or scales; page changes keep a quick crossfade.",
    "duration": {
      "quick": { "enter": 120, "exit": 90, "use": "hover, press, color and selection changes, tooltips" },
      "small": { "enter": 200, "exit": 140, "use": "chips, banners, toasts, menus, popovers, list rows" },
      "large": { "enter": 260, "exit": 180, "use": "pages, tabs, sheets, expand and collapse" }
    },
    "easing": {
      "enter": [0.05, 0.7, 0.1, 1],
      "exit": [0.3, 0, 0.8, 0.15],
      "move": [0.2, 0, 0, 1]
    },
    "distance": {
      "rise": 8,
      "pageSlide": 0.1,
      "popScale": 0.96
    },
    "spring": {
      "gentle": {
        "stiffness": 220,
        "damping": 26,
        "use": "page and panel transitions"
      },
      "standard": {
        "stiffness": 380,
        "damping": 30,
        "use": "cards, sheets, expanding a notification into a conversation"
      },
      "snappy": {
        "stiffness": 620,
        "damping": 34,
        "use": "toggles, chips, buttons, hover lift"
      }
    },
    "fade": {
      "fast": 120,
      "normal": 200
    },
    "hoverLift": 2,
    "pressScale": 0.97
  },
  "icons": {
    "set": "Material Symbols Rounded (Apache-2.0)",
    "size": 20,
    "stroke": "outlined, 400 weight; filled when selected"
  }
}
